# ==============================================================================
# Winix - Configuração Centralizada (Hyper-V GPU-P + Omarchy + Sunshine/Moonlight)
# Copie este arquivo para `.env` na raiz do repositório e ajuste conforme necessário.
# ==============================================================================

# --- Hyper-V / VM (Partição NVMe dedicada D:\ "Linux" - 2.28 TB) ---
VM_NAME=omarchy
VM_CPU_COUNT=16
# Host com 96 GB RAM: inicia folgado em 16 GB, encolhe até 4 GB ocioso e sobe até 64 GB sob carga pesada
VM_MEMORY_STARTUP_GB=16
VM_MEMORY_MIN_GB=4
VM_MEMORY_MAX_GB=64
VM_PATH=D:\VMs\omarchy
VM_VHD_PATH=D:\VMs\omarchy\omarchy.vhdx
VM_VHD_SIZE_GB=1500
# ISO do Omarchy (auto-detecta qualquer omarchy*.iso dentro de D:\isos\)
VM_ISO_PATH=D:\isos\omarchy.iso

# --- GPU Paravirtualization (GPU-P) ---
# Filtro travado exclusivamente na GPU NVIDIA dedicada (ignora AMD Radeon iGPU VEN_1002)
GPU_VENDOR_FILTER=*VEN_10DE*
GPU_DEVICE_FILTER=*VEN_10DE&DEV_2C05*
VM_LOW_MMIO_GB=1
VM_HIGH_MMIO_GB=64

# --- Rede Interna Dedicada (< 1ms) ---
SWITCH_NAME=Switch-Omarchy
NAT_NAME=NAT-Omarchy
HOST_IP=192.168.50.1
VM_IP=192.168.50.2
NET_PREFIX_LENGTH=24
NAT_SUBNET=192.168.50.0/24
DNS_SERVERS=1.1.1.1 9.9.9.9

# --- Acesso SSH na VM ---
VM_USER=seu_usuario
SSH_PORT=22
# Caminho no Windows (para scripts .ps1)
SSH_KEY_PATH_WIN=%USERPROFILE%\.ssh\id_ed25519
# Caminho no WSL2/Linux (para scripts .sh)
SSH_KEY_PATH_WSL=~/.ssh/id_ed25519

# --- Display Virtual & Omarchy / Hyprland ---
DISPLAY_OUTPUT=Virtual-1
DISPLAY_RESOLUTION=3440x1440
DISPLAY_REFRESH_RATE=60
DISPLAY_SCALE=1
# Instala linux-lts + linux-lts-headers como fallback estável para dxgkrnl-dkms
OMARCHY_INSTALL_LTS_KERNEL=true

# --- Sunshine & Moonlight ---
SUNSHINE_PORT=47990
SUNSHINE_APP_NAME=Omarchy
MOONLIGHT_EXE_PATH=C:\Program Files\Moonlight Game Streaming\Moonlight.exe
# Se "true", ao voltar ao Modo IA o script conecta diretamente no app do Sunshine
MOONLIGHT_AUTO_STREAM=false

# --- Serviços de IA na VM (para descarga de VRAM no Modo BF6) ---
# Lista separada por vírgulas de serviços systemd opcionais a parar/reiniciar (além do `ollama stop`)
AI_SYSTEMD_SERVICES=ollama
# Se "true", também reinicia os serviços acima caso ainda reste VRAM alocada após `ollama stop`
AI_FORCE_RESTART_SERVICES=false
